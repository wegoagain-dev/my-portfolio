---
import '@/styles/global.css'
import '@/styles/typography.css'

import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { SITE } from '@/consts'
import { cn } from '@/lib/utils'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<!doctype html>
<html
  class="bg-background text-foreground scheme-light-dark"
  lang={SITE.locale}
>
  <Head>
    <slot name="head" />
  </Head>
  <body class="flex h-fit min-h-screen flex-col gap-y-6 font-sans">
    <a
      href="#main-content"
      class="focus:bg-background sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:border focus:px-4 focus:py-2"
    >
      Skip to main content
    </a>
    <header
      id="main-header"
      class="sticky top-0 z-50 divide-y transition-all duration-300 xl:divide-none"
    >
      <Header />
      <slot name="subposts-navigation" />
      <slot name="table-of-contents" />
    </header>
    <main
      id="main-content"
      class={cn('w-full mx-auto flex grow flex-col gap-y-6 px-4', className)}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  function initHeaderScroll() {
    if (typeof window.__headerScrollCleanup === 'function') {
      window.__headerScrollCleanup()
    }

    const header = document.getElementById('main-header')
    if (!header) return

    const updateHeader = () => {
      if (window.scrollY > 0) {
        header.classList.add('bg-background/50', 'backdrop-blur-sm')
        header.classList.remove('bg-transparent')
      } else {
        header.classList.remove('bg-background/50', 'backdrop-blur-sm')
        header.classList.add('bg-transparent')
      }
    }

    window.addEventListener('scroll', updateHeader, { passive: true })
    updateHeader()

    window.__headerScrollCleanup = () => {
      window.removeEventListener('scroll', updateHeader)
    }
  }

  document.addEventListener('astro:page-load', initHeaderScroll)
</script>
