---
import MetaPage from "@/components/MetaPage.astro"
import PhotoGallery from "@/components/PhotoGallery.astro"
import Layout from "@/layouts/Layout.astro"
import type { ImageMetadata } from "astro"

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/photos/*.{jpeg,jpg,png,gif,webp,avif}",
  { eager: true },
)

// Sorted by filename; alt text derived from it ("01-my-photo.jpg" -> "My photo")
const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const name = path
      .split("/")
      .pop()!
      .replace(/\.[^.]+$/, "")
      .replace(/^\d+[-_]/, "")
      .replace(/[-_]+/g, " ")
    return {
      image: mod.default,
      alt: name.charAt(0).toUpperCase() + name.slice(1),
    }
  })
---

<Layout>
  <MetaPage slot="head" title="Photos" description="My thoughts in images." />
  <page-intro>
    <h1>Photos</h1>
    <p>My thoughts in images.</p>
  </page-intro>
  {photos.length > 0 ? (
    <PhotoGallery photos={photos} />
  ) : (
    <p class="empty">Photos coming soon.</p>
  )}
</Layout>

<style>
  page-intro {
    display: block;
    margin-block-end: var(--space-m);

    h1 {
      font-size: var(--step-2);
      font-weight: var(--font-weight-medium);
      line-height: calc(var(--leading-offset) + 1em);
    }

    p {
      color: var(--muted-foreground);
    }
  }

  .empty {
    color: var(--muted-foreground);
  }
</style>
