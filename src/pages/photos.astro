---
import MetaPage from "@/components/MetaPage.astro"
import PhotoGallery from "@/components/PhotoGallery.astro"
import Layout from "@/layouts/Layout.astro"
import type { ImageMetadata } from "astro"

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/photos/*.{jpeg,jpg,png,gif,webp,avif}",
  { eager: true },
)

// Sorted by filename; alt text derived from it ("01-my-photo.jpg" -> "My photo")
const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const name = path
      .split("/")
      .pop()!
      .replace(/\.[^.]+$/, "")
      .replace(/^\d+[-_]/, "")
      .replace(/[-_]+/g, " ")
    return {
      image: mod.default,
      alt: name.charAt(0).toUpperCase() + name.slice(1),
    }
  })
---

<Layout>
  <MetaPage slot="head" title="Photos" description="My thoughts in images." />
  {photos.length > 0 ? (
    <PhotoGallery photos={photos} />
  ) : (
    <p>Photos coming soon.</p>
  )}
</Layout>

<style>
  p {
    color: var(--muted-foreground);
  }
</style>
