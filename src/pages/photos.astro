---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import PhotoGallery from '@/components/PhotoGallery.astro'
import Layout from '@/layouts/Layout.astro'
import type { ImageMetadata } from 'astro'

// Import all images from the photos folder
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/*.{jpeg,jpg,png,gif,webp}',
  { eager: true },
)

// Convert to array and sort by filename
const images: ImageMetadata[] = Object.entries(imageModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, module]) => module.default)

const hasImages = images.length > 0
---

<Layout class="max-w-5xl">
  <PageHead
    slot="head"
    title="Photos"
    description="A collection of photos from my travels and adventures."
  />
  <Breadcrumbs items={[{ label: 'Photos', icon: 'lucide:camera' }]} />

  <section>
    <div class="mb-8">
      <h1 class="mb-4 text-2xl font-medium">Photos</h1>
      <p class="text-muted-foreground">
        my thoughts in images
      </p>
    </div>

    {hasImages && <PhotoGallery images={images} />}

    {
      !hasImages && (
        <div class="flex h-64 items-center justify-center rounded-md border border-dashed">
          <p class="text-muted-foreground">
            No photos yet. Add images to
            <code class="bg-muted ml-1 rounded px-1 py-0.5 text-sm">
              src/assets/photos/
            </code>
          </p>
        </div>
      )
    }
  </section>
</Layout>
