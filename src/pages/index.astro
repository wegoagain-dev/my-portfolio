---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
---

<Layout>
  <MetaPage slot="head" />
  <intro-section>
    <h1>Hey, I'm Tawfiq.</h1>
    <prose-content>
      <p>
        I'm an IT engineer working in Azure, currently learning identity and
        access management and cloud engineering.
      </p>
      <p>
        I'm naturally curious and like to keep up with what's happening across
        the IT world. I'll post whatever's on my mind, and who knows, some of it
        might be useful to you.
      </p>
    </prose-content>
  </intro-section>
</Layout>

<style>
  intro-section {
    display: block;
    font-size: var(--step-0);
    color: var(--muted-foreground);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    h1 {
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin-block-end: var(--space-xs);
    }
  }
</style>
