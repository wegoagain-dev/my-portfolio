---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { Image } from 'astro:assets'
import aboutImage from '../../public/static/about-image.png'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <section>
    <div class="min-w-full">
      <div class="prose mb-6">
        <p class="mt-0">
          I am a DevOps engineer focused on practical, production-ready systems.
        </p>
        <p>
          I treat this site as a technical knowledge base: architecture notes,
          implementation walkthroughs, and lessons learned while building on AWS
          and Kubernetes.
        </p>
        <p>
          You can explore my <Link href="/work" underline>work</Link>, read my
          latest <Link href="/blog" underline>posts</Link>, or check out my <Link
            href="/toolkit"
            underline>toolkit</Link
          > for the workflows and tools I use daily.
        </p>
        <p>
          <span class="text-foreground font-medium">Current focus:</span> I am building
          out a homelab with <Link href="https://k3s.io/" external underline
            >k3s</Link
          > to sharpen Kubernetes operations skills in a controlled environment.
          I am also documenting the process in a practical guide that will be published
          soon in the <Link href="/kubernetes" underline
            >Kubernetes section</Link
          >.
        </p>
      </div>
      <div class="mb-8">
        <Image
          src={aboutImage}
          alt="Abstract desert landscape with ancient arches"
          class="h-auto w-full rounded-lg object-cover shadow-sm"
        />
        <p class="text-muted-foreground mt-2 text-sm">
          I like combining technical depth with clean presentation.
        </p>
      </div>
    </div>
  </section>
</Layout>
