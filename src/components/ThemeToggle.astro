---
import { Button } from '@/components/ui/button'
import { Icon } from 'astro-icon/components'

interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
---

<Button
  data-theme-toggle
  variant="ghost"
  size="icon"
  title="Toggle theme"
  aria-label="Toggle theme"
  className={`-my-2 -me-2 size-8 ${className}`}
>
  <Icon name="lucide:sun" class="size-4 dark:hidden" />
  <Icon name="lucide:moon" class="absolute hidden size-4 dark:block" />
  <span class="sr-only">Toggle theme</span>
</Button>

<script is:inline data-astro-rerun>
  ;(() => {
    const theme = (() => {
      const stored = localStorage?.getItem('theme') ?? ''
      if (['dark', 'light'].includes(stored)) return stored
      return window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light'
    })()

    document.documentElement.setAttribute('data-theme', theme)
    window.localStorage.setItem('theme', theme)
  })()
</script>

<script>
  const THEME_TOGGLE_SELECTOR = '[data-theme-toggle]'

  function getPreferredTheme() {
    const stored = localStorage?.getItem('theme') ?? ''
    if (stored === 'dark' || stored === 'light') return stored

    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'light'
  }

  function applyTheme(theme: 'dark' | 'light', disableTransition = false) {
    const element = document.documentElement

    if (disableTransition) {
      element.classList.add('[&_*]:transition-none')
    }

    element.setAttribute('data-theme', theme)
    localStorage.setItem('theme', theme)

    if (disableTransition) {
      window.getComputedStyle(element).getPropertyValue('opacity')
      requestAnimationFrame(() => {
        element.classList.remove('[&_*]:transition-none')
      })
    }
  }

  function handleToggleClick() {
    const element = document.documentElement
    const currentTheme = element.getAttribute('data-theme')
    const newTheme =
      (currentTheme === 'dark' ? 'light' : 'dark') as 'dark' | 'light'
    applyTheme(newTheme, true)
  }

  function initThemeToggle() {
    const toggles = Array.from(
      document.querySelectorAll<HTMLElement>(THEME_TOGGLE_SELECTOR),
    )

    toggles.forEach((toggle) => {
      if (toggle.dataset.themeToggleBound === 'true') return
      toggle.addEventListener('click', handleToggleClick)
      toggle.dataset.themeToggleBound = 'true'
    })
  }

  initThemeToggle()

  document.addEventListener('astro:after-swap', () => {
    applyTheme(getPreferredTheme(), true)
    initThemeToggle()
  })
</script>
