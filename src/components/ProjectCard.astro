---
import Link from '@/components/Link.astro'
import { formatDate } from '@/lib/utils'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
  compact?: boolean
}

const { project, compact = false } = Astro.props

const highlightSummary =
  project.data.impact ||
  project.data.scale ||
  project.data.availability ||
  project.data.cost ||
  project.data.keyLearning
---

<Link
  href={project.data.link}
  class="group not-prose flex flex-col gap-1 no-underline"
  external
>
  {
    !compact && project.data.image && (
      <div class="mb-3 overflow-hidden rounded-lg">
        <Image
          src={project.data.image}
          alt={project.data.name}
          width={1200}
          height={630}
          loading="lazy"
          decoding="async"
          class="w-full scale-[1.12] object-cover object-center transition-transform duration-300 group-hover:scale-[1.16]"
        />
      </div>
    )
  }
  <div class="flex items-start justify-between gap-4">
    <h3
      class="group-hover:decoration-foreground/50 font-medium group-hover:underline group-hover:underline-offset-4"
    >
      {project.data.name}
    </h3>
    {
      project.data.startDate && (
        <span class="text-muted-foreground shrink-0 text-sm">
          {formatDate(project.data.startDate)}
        </span>
      )
    }
  </div>
  <p class="text-muted-foreground text-sm">
    {project.data.description}
  </p>
  {
    !compact && highlightSummary && (
      <p class="text-muted-foreground/80 text-xs">{highlightSummary}</p>
    )
  }
  {
    project.data.tags && (
      <p class="text-muted-foreground text-xs">
        {project.data.tags.join(' · ')}
      </p>
    )
  }
</Link>
