---
import Link from '@/components/Link.astro'
import { formatDate } from '@/lib/utils'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
  compact?: boolean
}

const { project, compact = false } = Astro.props

const projectHighlights = [
  project.data.impact && `Impact: ${project.data.impact}`,
  project.data.scale && `Scale: ${project.data.scale}`,
  project.data.availability && `Availability: ${project.data.availability}`,
  project.data.cost && `Cost: ${project.data.cost}`,
  project.data.keyLearning && `Key Learning: ${project.data.keyLearning}`,
].filter(Boolean)

const visibleHighlights = compact
  ? projectHighlights.slice(0, 2)
  : projectHighlights.slice(0, 3)
---

<Link
  href={project.data.link}
  class="group not-prose flex flex-col gap-1 no-underline"
  external
>
  {
    !compact && project.data.image && (
      <div class="mb-3 overflow-hidden rounded-lg">
        <Image
          src={project.data.image}
          alt={project.data.name}
          width={1200}
          height={630}
          loading="lazy"
          decoding="async"
          class="w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        />
      </div>
    )
  }
  <div class="flex items-start justify-between gap-4">
    <h3
      class="group-hover:decoration-foreground/50 font-medium group-hover:underline group-hover:underline-offset-4"
    >
      {project.data.name}
    </h3>
    {
      project.data.startDate && (
        <span class="text-muted-foreground shrink-0 text-sm">
          {formatDate(project.data.startDate)}
        </span>
      )
    }
  </div>
  <p class="text-muted-foreground text-sm">
    {project.data.description}
  </p>
  {
    visibleHighlights.length > 0 && (
      <ul class="text-muted-foreground/80 mt-1 space-y-1 text-xs">
        {visibleHighlights.map((highlight) => (
          <li>{highlight}</li>
        ))}
      </ul>
    )
  }
  {
    project.data.tags && (
      <p class="text-muted-foreground/70 text-xs">
        {project.data.tags.join(' · ')}
      </p>
    )
  }
</Link>
