---
import type { ImageMetadata } from "astro"
import { getImage, Image } from "astro:assets"

type Props = { photos: { image: ImageMetadata; alt: string }[] }

const { photos } = Astro.props

const full = await Promise.all(
  photos.map(({ image }) =>
    getImage({
      src: image,
      width: Math.min(image.width, 2000),
      format: "webp",
    }),
  ),
)
---

<photo-gallery>
  <ul>
    {photos.map(({ image, alt }, i) => (
      <li>
        <button
          type="button"
          data-photo={i}
          data-full={full[i].src}
          aria-label={`Open ${alt}`}
        >
          <Image
            src={image}
            alt={alt}
            widths={[400, 800, 1200]}
            sizes="(width < 40rem) 100vw, 50vw"
            loading={i < 4 ? "eager" : "lazy"}
          />
        </button>
      </li>
    ))}
  </ul>

  <dialog data-photo-viewer aria-label="Photo viewer">
    <img alt="" decoding="async">
    <p></p>
    <form method="dialog">
      <button type="submit">Close</button>
    </form>
  </dialog>
</photo-gallery>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(
    "[data-photo-viewer]",
  )
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-photo]"),
  ]

  if (dialog && buttons.length > 0) {
    const img = dialog.querySelector("img")!
    const caption = dialog.querySelector("p")!
    let current = 0

    const show = (index: number) => {
      current = (index + buttons.length) % buttons.length
      const alt = buttons[current].querySelector("img")?.alt ?? ""
      img.src = buttons[current].dataset.full ?? ""
      img.alt = alt
      caption.textContent = alt
    }

    for (const button of buttons) {
      button.addEventListener("click", () => {
        show(Number(button.dataset.photo))
        dialog.showModal()
      })
    }

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close()
    })

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") show(current + 1)
      if (event.key === "ArrowLeft") show(current - 1)
    })

    dialog.addEventListener("close", () => buttons[current]?.focus())
  }
</script>

<style>
  photo-gallery {
    display: block;
  }

  ul {
    columns: 2 16rem;
    column-gap: var(--space-s);

    li {
      break-inside: avoid;
      margin-block-end: var(--space-s);
    }
  }

  ul button {
    display: block;
    inline-size: 100%;
    cursor: zoom-in;

    :global(img) {
      inline-size: 100%;
      block-size: auto;
    }
  }

  dialog {
    inline-size: 100%;
    max-inline-size: 100%;
    block-size: 100%;
    max-block-size: 100%;
    padding: var(--space-m);
    background: transparent;
    color: var(--foreground);

    &[open] {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-xs);
    }

    &::backdrop {
      background-color: color-mix(in oklab, var(--background) 90%, transparent);
      backdrop-filter: blur(var(--blur-sm));
    }

    img {
      max-inline-size: min(100%, 75rem);
      max-block-size: calc(100svh - 7rem);
      object-fit: contain;
    }

    p {
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }

    form {
      position: absolute;
      inset-block-start: var(--space-s);
      inset-inline-end: var(--space-s);

      button {
        font-size: var(--step--1);
        color: var(--muted-foreground);
        cursor: pointer;

        &:hover {
          color: var(--foreground);
        }
      }
    }
  }
</style>
