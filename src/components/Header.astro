---
import Link from '@/components/Link.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import { NAV_LINKS, SITE } from '@/consts'
import { Icon } from 'astro-icon/components'

const currentPath = Astro.url.pathname
const isActivePath = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`)
---

<header class="relative">
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3"
  >
    <Link href="/" class="flex shrink-0 items-center justify-center">
      <span class="h-full text-lg leading-none font-medium">{SITE.title}</span>
    </Link>

    <div class="flex items-center gap-3">
      <nav class="hidden items-center gap-4 text-sm sm:flex sm:gap-6">
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              class:list={[
                'hover:text-accent capitalize transition-colors',
                isActivePath(item.href) ? 'text-accent' : 'text-foreground/60',
              ]}
              aria-current={isActivePath(item.href) ? 'page' : undefined}
            >
              {item.label}
            </Link>
          ))
        }
      </nav>

      <ThemeToggle transition:persist class="sm:hidden" />
      <ThemeToggle transition:persist class="hidden sm:flex" />

      <button
        id="mobile-menu-trigger"
        class="text-foreground/70 hover:text-foreground hover:bg-muted border-border flex h-9 w-9 items-center justify-center rounded-md border transition-colors sm:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="lucide:menu" class="h-4.5 w-4.5" id="menu-icon-open" />
        <Icon name="lucide:x" class="hidden h-4.5 w-4.5" id="menu-icon-close" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu border-border bg-background hidden border-t sm:hidden"
  >
    <nav class="mx-auto flex max-w-3xl flex-col gap-1 px-4 py-3">
      {
        NAV_LINKS.map((item) => (
          <Link
            href={item.href}
            class="text-foreground hover:bg-muted rounded-md px-3 py-2.5 capitalize transition-colors"
            data-mobile-nav-link
          >
            {item.label}
          </Link>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .mobile-menu {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }
</style>

<script>
  function initMobileMenu() {
    if (typeof window.__mobileMenuCleanup === 'function') {
      window.__mobileMenuCleanup()
    }

    const trigger = document.getElementById('mobile-menu-trigger')
    const menu = document.getElementById('mobile-menu')
    const iconOpen = document.getElementById('menu-icon-open')
    const iconClose = document.getElementById('menu-icon-close')
    const navLinks = Array.from(
      document.querySelectorAll<HTMLElement>('[data-mobile-nav-link]'),
    )
    let isOpen = false

    function setMenuState(open: boolean) {
      isOpen = open
      menu?.classList.toggle('hidden', !open)
      iconOpen?.classList.toggle('hidden', open)
      iconClose?.classList.toggle('hidden', !open)
      trigger?.setAttribute('aria-expanded', open ? 'true' : 'false')
    }

    function toggleMenu() {
      setMenuState(!isOpen)
    }

    function closeMenu() {
      setMenuState(false)
    }

    const handleEscape = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu()
      }
    }

    const handleOutsideClick = (e: MouseEvent) => {
      if (!isOpen || !menu || !trigger) return
      const target = e.target
      if (!(target instanceof Node)) return
      if (!menu.contains(target) && !trigger.contains(target)) {
        closeMenu()
      }
    }

    const handleResize = () => {
      if (window.innerWidth >= 640 && isOpen) {
        closeMenu()
      }
    }

    trigger?.addEventListener('click', toggleMenu)

    navLinks.forEach((link) => {
      link.addEventListener('click', closeMenu)
    })

    document.addEventListener('keydown', handleEscape)
    document.addEventListener('click', handleOutsideClick)
    window.addEventListener('resize', handleResize)
    setMenuState(false)

    window.__mobileMenuCleanup = () => {
      closeMenu()
      trigger?.removeEventListener('click', toggleMenu)
      navLinks.forEach((link) => {
        link.removeEventListener('click', closeMenu)
      })
      document.removeEventListener('keydown', handleEscape)
      document.removeEventListener('click', handleOutsideClick)
      window.removeEventListener('resize', handleResize)
    }
  }

  document.addEventListener('astro:page-load', initMobileMenu)
  document.addEventListener('astro:after-swap', initMobileMenu)
</script>
