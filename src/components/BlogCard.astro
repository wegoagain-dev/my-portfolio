---
import {
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import type { CollectionEntry } from 'astro:content'
import Link from './Link.astro'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTime = await getCombinedReadingTime(entry.id)
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
---

<Link
  href={`/${entry.collection}/${entry.id}`}
  class="group not-prose flex flex-col gap-1 py-3 no-underline"
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="font-medium group-hover:underline group-hover:decoration-foreground/50 group-hover:underline-offset-4">{entry.data.title}</h3>
    <span class="text-muted-foreground shrink-0 text-sm">{formattedDate}</span>
  </div>
  <div class="flex items-center justify-between gap-4">
    <p class="text-muted-foreground text-sm">{entry.data.description}</p>
    <span class="text-muted-foreground/70 shrink-0 text-xs">
      {readTime}{subpostCount > 0 && ` · ${subpostCount} parts`}
    </span>
  </div>
</Link>
